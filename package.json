{
  "name": "stocktrading",
  "version": "0.1.13",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "pnpm --filter web dev",
    "dev:ml": "cd services/ml && .venv/bin/uvicorn api.main:app --reload --host 0.0.0.0 --port 58123",
    "dev:control": "node services/control/server.mjs",
    "dev:mcp": "node services/mcp/index.mjs",
    "dev:convex": "cd apps/web && pnpm convex dev",
    "start": "bash dev.sh",
    "service:install": "bash scripts/service.sh install",
    "service:uninstall": "bash scripts/service.sh uninstall",
    "service:restart": "bash scripts/service.sh restart",
    "service:status": "bash scripts/service.sh status",
    "build": "pnpm --filter web build",
    "lint": "pnpm --filter web lint",
    "test": "vitest run --config tests/vitest.config.ts",
    "test:e2e": "tsx tests/e2e/run_full_stack.ts",
    "test:design": "tsx tests/e2e/design_audit.ts"
  },
  "devDependencies": {
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
